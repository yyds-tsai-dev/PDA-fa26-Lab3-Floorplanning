# Constructive-greedy harness (does not touch fp / Makefile).
#   make -f Makefile.construct        -> ./test_construct
CXX      ?= g++
CXXFLAGS ?= -O2 -Wall -Wextra
CXXFLAGS += -std=c++17 -I../verifier

test_construct: test_construct.cpp construct.h gp.h shape.h extract.h ../verifier/lab3_io.h mcf/wl_lp.h mcf/network_simplex.h
	$(CXX) $(CXXFLAGS) -o $@ test_construct.cpp

clean:
	rm -f test_construct

.PHONY: clean
