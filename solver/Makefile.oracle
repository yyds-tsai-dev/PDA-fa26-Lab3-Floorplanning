# Insertion-oracle harness (does not touch fp / Makefile).
#   make -f Makefile.oracle        -> ./test_oracle
CXX      ?= g++
CXXFLAGS ?= -O2 -Wall -Wextra
CXXFLAGS += -std=c++17 -I../verifier

test_oracle: test_oracle.cpp oracle.h gp.h shape.h extract.h ../verifier/lab3_io.h mcf/wl_lp.h mcf/network_simplex.h
	$(CXX) $(CXXFLAGS) -o $@ test_oracle.cpp

clean:
	rm -f test_oracle

.PHONY: clean
